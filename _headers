# Cloudflare Pages response headers for heynomnom.in (ignored by GitHub Pages).
# HTML revalidates on every visit (Pages default), so updates show without a hard refresh.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Images and clips rarely change; let browsers keep them for a week.
# If one is replaced, give the new file a new name so visitors get it straight away.
/assets/*
  Cache-Control: public, max-age=604800
